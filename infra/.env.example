# Copy to infra/.env and fill in. chmod 600. Never commit infra/.env.
# Generate secrets with: openssl rand -base64 32
# Never reuse a password across services.

# --- Caddy Let's Encrypt account contact (required) ---
ACME_EMAIL=ops@example.com

# --- Astro Shell / Shell Edge ---
# CI sets SHELL_IMAGE to ghcr.io/heff0/stagea-shell:<sha> on deploy.
# Host fallback without GHCR: SHELL_IMAGE=stagea-shell:local and `up --build shell`.
SHELL_IMAGE=ghcr.io/heff0/stagea-shell:main
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
PUBLIC_SITE_NAME=Stagea Community

# Public nav URLs. Forum/wiki processes start in Phase 1; blog/shop are placeholders only.
FORUM_URL=https://forum.stagea-stuff.com/
# Official mediawiki image serves the wiki at document root / (not /w/).
# Local wiki/ Submodule may use /w/; production does not.
WIKI_URL=https://wiki.stagea-stuff.com/
BLOG_URL=https://blog.stagea-stuff.com/
SHOP_URL=https://shop.stagea-stuff.com/

# Keycloak OIDC IdP — placeholders for Phase 1. Do not start Keycloak.
# Keys must be present (empty is not allowed); real values land in Phase 3.
AUTH_ISSUER_URL=https://auth.stagea-stuff.com/realms/stagea
AUTH_CLIENT_ID=shell-client
AUTH_CLIENT_SECRET=change-me

# Ghost Content API — placeholder for Phase 1. Do not start Ghost.
# Real key lands in slice 9 (blog).
GHOST_CONTENT_API_KEY=change-me

# Directus Parts API — Phase 3. Optional; unused until then.
# PARTS_API_URL=

# --- Object storage (S0 contract; volumes still hold uploads until wired) ---
# Disk scale path: when disk used / disk total > 0.7, send wiki images and forum
# uploads here instead of growing named volumes. Same bucket provider must differ
# from the VPS (backup rule). Do not put secrets in git.
# OBJECT_STORAGE_ENDPOINT=https://s3.example.com
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_BUCKET=stagea-media
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_PREFIX_WIKI=wiki-images/
# OBJECT_STORAGE_PREFIX_FORUM=forum-uploads/

# --- Forum (NodeBB) — official image, not the forum/ Submodule ---
# FORUM_URL is the single public URL key (also consumed by the Shell above).
FORUM_REDIS_PASSWORD=change-me

# --- Wiki (MediaWiki) — official image, not the wiki/ Submodule ---
# WIKI_URL is the single public URL key (also consumed by the Shell above).
WIKI_DB_NAME=mediawiki
WIKI_DB_USER=wiki
WIKI_DB_PASSWORD=change-me
WIKI_DB_ROOT_PASSWORD=change-me

---
import Layout from "~/layouts/Layout.astro";
import { runFederatedSearch, type SearchResult } from "~/lib/search";

// Read the search query from URL parameter (SSR request-time evaluation)
const url = new URL(Astro.request.url);
const query = url.searchParams.get("q") || "";

let results: SearchResult[] = [];
let hasSearched = false;
let error: string | null = null;

if (query.trim()) {
  try {
    results = await runFederatedSearch(query);
    hasSearched = true;
  } catch (err) {
    console.error("[Search Page] Error running federated search:", err);
    error = "Something went wrong during federated search. Please try again.";
  }
}

// Group counts for filters
const counts = {
  all: results.length,
  blog: results.filter(r => r.source === "blog").length,
  shop: results.filter(r => r.source === "shop").length,
  forum: results.filter(r => r.source === "forum").length,
  wiki: results.filter(r => r.source === "wiki").length,
};

const sources = [
  { key: "blog", label: "Blog", color: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" },
  { key: "shop", label: "Shop", color: "bg-sky-500/10 text-sky-400 border-sky-500/20" },
  { key: "forum", label: "Forum", color: "bg-purple-500/10 text-purple-400 border-purple-500/20" },
  { key: "wiki", label: "Wiki", color: "bg-amber-500/10 text-amber-400 border-amber-500/20" },
];
---

<Layout
  title={query ? `Search: "${query}" — Stagea` : "Search — Stagea"}
  description="Federated community search across the Nissan Stagea forum, wiki, blog and parts catalogue."
>
  <div class="max-w-4xl mx-auto py-8">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-white via-neutral-100 to-neutral-400 bg-clip-text text-transparent">
        Federated Search
      </h1>
      <p class="mt-2 text-neutral-400 max-w-xl mx-auto">
        Query the entire Stagea community ecosystem in one click — forum threads, wiki articles, blog stories, and product listings.
      </p>
    </header>

    <!-- Search Form -->
    <form method="GET" action="/search" class="mb-12">
      <div class="relative flex items-center">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search for parts, wiki guides, forum posts..."
          required
          minlength="2"
          class="w-full h-14 pl-5 pr-32 rounded-xl bg-neutral-900/60 border border-neutral-800 text-white placeholder-neutral-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all backdrop-blur-md"
        />
        <button
          type="submit"
          class="absolute right-2 h-10 px-6 rounded-lg bg-amber-500 hover:bg-amber-400 text-neutral-950 font-semibold text-sm tracking-wide transition shadow-lg shadow-amber-500/20"
        >
          Search
        </button>
      </div>
    </form>

    {error && (
      <div class="p-4 mb-8 rounded-lg bg-red-950/40 border border-red-900/50 text-red-400 text-sm">
        {error}
      </div>
    )}

    {hasSearched ? (
      <div>
        <!-- Results Stats & Tabs -->
        <div class="flex flex-wrap items-center justify-between border-b border-neutral-800 pb-4 mb-8 gap-4">
          <p class="text-sm text-neutral-400">
            Found <span class="font-semibold text-white">{results.length}</span> results for <span class="italic text-amber-400">"{query}"</span>
          </p>

          <div class="flex gap-2 text-xs">
            <span class="px-2.5 py-1 rounded bg-neutral-900 border border-neutral-800 text-neutral-300">
              All ({counts.all})
            </span>
            {sources.map(src => counts[src.key as keyof typeof counts] > 0 && (
              <span class={`px-2.5 py-1 rounded border ${src.color}`}>
                {src.label} ({counts[src.key as keyof typeof counts]})
              </span>
            ))}
          </div>
        </div>

        {results.length > 0 ? (
          <div class="space-y-6">
            {results.map((result) => {
              const sourceConfig = sources.find(s => s.key === result.source);
              return (
                <article class="p-6 rounded-xl border border-neutral-900 bg-neutral-950/20 hover:bg-neutral-950/40 hover:border-neutral-800 transition group relative flex flex-col md:flex-row gap-6">
                  {result.imageUrl && (
                    <div class="w-full md:w-24 h-24 rounded-lg overflow-hidden border border-neutral-900 bg-neutral-900 shrink-0">
                      <img src={result.imageUrl} alt="" class="w-full h-full object-cover" />
                    </div>
                  )}
                  <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2 flex-wrap">
                      <span class={`px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border ${sourceConfig?.color || "bg-neutral-900 border-neutral-800 text-neutral-400"}`}>
                        {result.source}
                      </span>
                      {result.price && (
                        <span class="text-xs font-semibold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">
                          {result.price}
                        </span>
                      )}
                      {result.publishedAt && (
                        <time class="text-xs text-neutral-500">
                          {new Date(result.publishedAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}
                        </time>
                      )}
                    </div>
                    <h2 class="text-xl font-bold text-white group-hover:text-amber-400 transition mb-2">
                      <a href={result.url} target="_blank" rel="noopener noreferrer" class="focus:outline-none after:absolute after:inset-0">
                        {result.title}
                      </a>
                    </h2>
                    <p class="text-sm text-neutral-400 leading-relaxed" set:html={result.snippet}>
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-16 border border-neutral-900/60 rounded-xl bg-neutral-950/10">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-neutral-600 mx-auto mb-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.637 10.637Z" />
            </svg>
            <h3 class="text-lg font-bold text-white mb-1">No community results found</h3>
            <p class="text-sm text-neutral-500 max-w-sm mx-auto">
              We couldn't find matches across our forum, wiki, blog, or store. Try checking your spelling or using different keywords.
            </p>
          </div>
        )}
      </div>
    ) : (
      <!-- Empty State / Guide -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <div class="p-6 rounded-xl border border-neutral-900 bg-neutral-950/20">
          <h3 class="text-sm font-semibold text-neutral-300 uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> How Federated Search Works
          </h3>
          <p class="text-sm text-neutral-400 leading-relaxed">
            The Stagea shell site utilizes 12-factor backing service interfaces to parallel-fetch content directly from independent application nodes. This isolates service failures and prevents single-point-of-failure bottlenecks.
          </p>
        </div>
        <div class="p-6 rounded-xl border border-neutral-900 bg-neutral-950/20">
          <h3 class="text-sm font-semibold text-neutral-300 uppercase tracking-wider mb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Target Endpoints
          </h3>
          <ul class="text-xs text-neutral-400 space-y-2">
            <li class="flex justify-between border-b border-neutral-900 pb-1.5">
              <span>NodeBB Forum API</span>
              <span class="text-neutral-500">Active</span>
            </li>
            <li class="flex justify-between border-b border-neutral-900 pb-1.5">
              <span>MediaWiki Query API</span>
              <span class="text-neutral-500">Active</span>
            </li>
            <li class="flex justify-between border-b border-neutral-900 pb-1.5">
              <span>Ghost Content API</span>
              <span class="text-neutral-500">Active</span>
            </li>
            <li class="flex justify-between">
              <span>Saleor GraphQL API</span>
              <span class="text-neutral-500">Active</span>
            </li>
          </ul>
        </div>
      </div>
    )}
  </div>
</Layout>

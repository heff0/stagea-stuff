---
import Layout from "~/layouts/Layout.astro";
import { AuthContext, type UserSession, type Submodule } from "~/lib/auth";

// Read existing session from cookies (12-factor stateless cookie session model)
const sessionCookie = Astro.cookies.get("stagea_mock_session");
let userSession: UserSession | null = null;

if (sessionCookie) {
  try {
    userSession = JSON.parse(sessionCookie.value) as UserSession;
  } catch {
    Astro.cookies.delete("stagea_mock_session");
  }
}

// Security Gate: Redirect to login if not authenticated
const auth = new AuthContext(userSession);
if (!auth.isAuthenticated() || !userSession) {
  return Astro.redirect("/account");
}

const session = auth.getSession()!;

// Determine active submodules the user has permission to interact with
const activeServices = [
  { key: "forum", name: "Forum Discussion", roleRequired: "user", href: userSession.roles.submodules.forum.length > 0 ? "http://localhost:4567/" : null },
  { key: "wiki", name: "Wiki Knowledge Base", roleRequired: "user", href: userSession.roles.submodules.wiki.length > 0 ? "http://localhost:8080/w/" : null },
  { key: "blog", name: "Community Blog", roleRequired: "user", href: userSession.roles.submodules.blog.length > 0 ? "http://localhost:2368/" : null },
  { key: "shop", name: "Parts Storefront", roleRequired: "user", href: userSession.roles.submodules.shop.length > 0 ? "http://localhost:3000/" : null }
].filter(s => s.href !== null);

// Check if user has admin access on any submodule
const hasAnyAdminAccess = ["forum", "wiki", "blog", "shop", "parts", "shell"].some(
  sub => auth.hasPermission(sub as any, "admin")
);
---

<Layout
  title={`Dashboard: ${session.displayName} — Stagea`}
  description="Personal community dashboard, active OIDC claims, and customized service quick links."
>
  <div class="max-w-5xl mx-auto py-8">

    <!-- Dashboard Header -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-neutral-800 pb-8 mb-10">
      <div>
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">User Dashboard</span>
        <h1 class="text-3xl font-extrabold text-white tracking-tight mt-1">
          Welcome back, {session.displayName}!
        </h1>
        <p class="text-sm text-neutral-400 mt-1">
          Currently managing your community profile and scoped OIDC credentials.
        </p>
      </div>

      <div class="flex gap-3">
        {hasAnyAdminAccess && (
          <a
            href="/admin"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 font-bold text-sm hover:bg-red-500/20 transition shadow-lg shadow-red-500/[0.02]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 0 1 1.45.12l.773.774a1.125 1.125 0 0 1 .12 1.45l-.527.737c-.25.35-.273.805-.108 1.205.164.397.505.71.93.78l.894.15c.542.09.94.56.94 1.11v1.094c0 .55-.398 1.02-.94 1.11l-.894.149c-.424.07-.764.383-.929.78-.164.398-.143.854.107 1.204l.527.738a1.125 1.125 0 0 1-.12 1.45l-.774.773a1.125 1.125 0 0 1-1.45.12l-.737-.527c-.35-.25-.805-.273-1.205-.108-.397.164-.71.505-.78.93l-.15.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.149-.894c-.07-.424-.383-.764-.78-.929-.398-.164-.854-.143-1.204.107l-.738.527a1.125 1.125 0 0 1-1.45-.12l-.773-.774a1.125 1.125 0 0 1-.12-1.45l.527-.737c.25-.35.273-.805.108-1.205-.164-.397-.505-.71-.93-.78l-.894-.15a1.125 1.125 0 0 1-.94-1.11v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.764-.383.929-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 0 1 .12-1.45l.774-.773a1.125 1.125 0 0 1 1.45-.12l.737.527c.35.25.805.273 1.205.108.397-.164.71-.505.78-.93l.15-.894Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            Admin Console
          </a>
        )}
        <form method="POST" action="/account">
          <input type="hidden" name="action" value="logout" />
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-900 text-neutral-300 font-semibold text-sm transition"
          >
            Sign Out
          </button>
        </form>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Left Column: Session Profile details -->
      <div class="space-y-6">
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/40 backdrop-blur-md">
          <div class="w-20 h-24 rounded-2xl bg-neutral-900 border border-neutral-800 flex items-center justify-center font-mono font-bold text-amber-400 text-4xl mb-4 shadow-inner">
            {session.username.substring(0, 2).toUpperCase()}
          </div>
          <h2 class="text-xl font-bold text-white">{session.displayName}</h2>
          <p class="text-xs text-neutral-500">@{session.username}</p>

          <div class="mt-6 space-y-4 border-t border-neutral-900 pt-6 text-sm text-neutral-400">
            <div>
              <span class="text-xs text-neutral-500 font-semibold uppercase block">Verified Email</span>
              <span class="text-white mt-1 block">{session.email}</span>
            </div>
            <div>
              <span class="text-xs text-neutral-500 font-semibold uppercase block">Identity ID (OIDC)</span>
              <span class="font-mono text-xs text-neutral-400 mt-1 block select-all bg-neutral-950 border border-neutral-900 p-2 rounded">{session.userId}</span>
            </div>
          </div>
        </div>

        <!-- OIDC Configuration Stats -->
        <div class="p-6 rounded-2xl border border-neutral-900 bg-neutral-950/20">
          <h3 class="text-xs font-bold text-neutral-400 uppercase tracking-widest mb-4">Central Identity Status</h3>
          <div class="space-y-3 text-xs">
            <div class="flex justify-between border-b border-neutral-900 pb-2">
              <span class="text-neutral-500">OIDC Client</span>
              <span class="font-mono text-neutral-300">shell-client</span>
            </div>
            <div class="flex justify-between border-b border-neutral-900 pb-2">
              <span class="text-neutral-500">Scope Type</span>
              <span class="text-emerald-400">offline_access</span>
            </div>
            <div class="flex justify-between">
              <span class="text-neutral-500">Cookie Protocol</span>
              <span class="text-amber-500">Stateless JWT</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Columns: Scoped services and Claim details -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Scoped Modules Access Grid -->
        <div>
          <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Your Scoped Service Privileges
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {activeServices.length > 0 ? (
              activeServices.map(service => {
                const roles = session.roles.submodules[service.key as Submodule] || [];
                const isAdmin = roles.includes("admin");
                const isEditor = roles.includes("editor");

                let badgeClass = "bg-neutral-900 text-neutral-400 border-neutral-800";
                let badgeLabel = "Member Access";

                if (isAdmin) {
                  badgeClass = "bg-red-500/10 text-red-400 border-red-500/20";
                  badgeLabel = "Administrator";
                } else if (isEditor) {
                  badgeClass = "bg-amber-500/10 text-amber-400 border-amber-500/20";
                  badgeLabel = "Editor / Scribe";
                }

                return (
                  <div class="p-5 rounded-2xl border border-neutral-900 bg-neutral-950/20 flex flex-col justify-between hover:border-neutral-800 transition">
                    <div class="flex items-start justify-between gap-3 mb-4">
                      <div>
                        <h3 class="font-bold text-white text-base">{service.name}</h3>
                        <p class="text-xs text-neutral-500 mt-0.5">Subdomain integrated</p>
                      </div>
                      <span class={`px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded-md border ${badgeClass}`}>
                        {badgeLabel}
                      </span>
                    </div>

                    <a
                      href={service.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs text-amber-400 hover:text-amber-300 font-semibold transition mt-2 self-start"
                    >
                      Launch Application Panel
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                    </a>
                  </div>
                );
              })
            ) : (
              <div class="md:col-span-2 text-center p-8 border border-dashed border-neutral-900 rounded-2xl bg-neutral-950/10">
                <p class="text-sm text-neutral-400">No active submodule authorizations found. Please contact an admin.</p>
              </div>
            )}
          </div>
        </div>

        <!-- Identity Provider profile configuration instructions -->
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/20">
          <h2 class="text-base font-bold text-white mb-2">Self-Service Profile Management (Planned)</h2>
          <p class="text-sm text-neutral-400 leading-relaxed">
            In our target 12-factor structure, changes to your profile details (such as email, password, profile picture, or 2FA credentials) live exclusively inside Keycloak at <code class="text-amber-400">auth.stagea-stuff.com</code>. This ensures an insulated backend where identity processes are kept secure.
          </p>
          <div class="mt-4 flex gap-3">
            <span class="inline-flex items-center rounded-lg bg-neutral-900 border border-neutral-800 px-4 py-2 text-xs font-semibold text-neutral-300 cursor-not-allowed">
              Edit Password (auth.stagea-stuff.com)
            </span>
            <span class="inline-flex items-center rounded-lg bg-neutral-900 border border-neutral-800 px-4 py-2 text-xs font-semibold text-neutral-300 cursor-not-allowed">
              Enable Two-Factor (MFA)
            </span>
          </div>
        </div>

      </div>

    </div>

  </div>
</Layout>
